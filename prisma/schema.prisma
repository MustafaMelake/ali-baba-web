// ─────────────────────────────────────────────────────────────────────────────
// Dual-business platform — Online Patisserie Shop + Dine-in Café Menu
// Datasource: PostgreSQL (Neon).  Connection URL is supplied by prisma.config.ts.
// Client:    `prisma-client` generator emitting to src/generated/prisma,
//            consumed via `@/generated/prisma/client` with the @prisma/adapter-pg
//            driver adapter (see src/lib/prisma.ts).
// Auth:      Better Auth standard models (User, Session, Account, Verification).
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  MANAGER // Branch Manager — scoped to a single Branch via User.branchId.
}

/// Which storefront a category / menu page belongs to.
enum CategoryType {
  SHOP // Online patisserie shop
  CAFE // Dine-in café menu
}

/// The five fixed, first-class categories surfaced in the homepage CategorySlider.
/// A Category that carries one of these is a "core" category (slider-eligible);
/// the @unique on Category.identifier guarantees exactly one row per value.
enum CategoryIdentifier {
  ORIENTAL_SWEETS
  WESTERN_SWEETS
  MOULID_SWEETS
  EID_SWEETS
  BAKERY
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Cities we deliver to.
enum DeliveryLocation {
  MENOUF
  SADAT
  SARS
  TITA
  BARHEEM
  AL_HAMOUL
}

/// How a Promotion's `value` is applied to a price.
enum DiscountType {
  PERCENTAGE // `value` is a percent off (e.g. 15 → 15% off)
  FIXED_AMOUNT // `value` is an absolute amount off (store currency)
}

// ─────────────────────────────────────────────────────────────────────────────
// Better Auth — standard models
// Field names & types must match what Better Auth's prismaAdapter expects.
// NOTE: credential passwords are stored on Account.password (NOT on User).
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)

  // Branch assignment.
  // OPTIONAL at the schema level by necessity: USER/ADMIN have no branch.
  // The rule "a MANAGER must have a branchId" is conditional and CANNOT be
  // expressed in Prisma — enforce it in app logic (and/or the DB CHECK
  // constraint described in the migration note).
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Auth relations
  sessions Session[]
  accounts Account[]

  // Business relations
  orders    Order[]
  reviews   Review[]
  cartItems CartItem[]

  wishlist  WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─────────────────────────────────────────────────────────────────────────────
// Branches (physical locations / boutiques)
// A Branch can have one or more staff users assigned to it; a "Branch Manager"
// is a User whose role == MANAGER and whose branchId points at this row.
// NOTE: Order.pickupBranch is still a free-text string — migrating it to a
// Branch relation is intentionally out of scope here.
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id       String  @id @default(cuid())
  name     String  @unique
  /// URL-safe identifier (mirrors Category.slug), e.g. "menouf", "beba".
  slug     String  @unique
  address  String?
  phone    String?
  /// Soft on/off switch for the location without deleting it.
  isActive Boolean @default(true)

  /// Users assigned to this branch (typically role == MANAGER).
  managers User[]

  /// Orders fulfilled by this branch (see Order.branchId).
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Product organization (matrix structure)
//
//   Category  → the product's *classification*        (Modern, Croissant, …)
//   MenuPage  → the UI page/section it is shown on     (a digital-menu page)
//   Product   → relates to BOTH a Category and a MenuPage
//   Variant   → the purchasable unit + its price       (Scoop, Litre, Pieces)
//
// Prices live ONLY on ProductVariant; carts & orders reference a variant id so
// the price is always resolved server-side (no client-supplied prices).
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id   String       @id @default(cuid())
  name String       @unique
  slug String       @unique
  type CategoryType @default(SHOP)

  // ── CategorySlider presentation fields ─────────────────────────────────────
  /// Short marketing tagline shown under the title in the slider card.
  subtitle   String?
  /// Hero image URL (or /public path) for the slider card.
  image      String?
  /// Marks this as one of the five core categories rendered in the homepage
  /// slider. NULL for ordinary categories. @unique → one row per enum value.
  identifier CategoryIdentifier? @unique

  products Product[]

  /// Promotions targeting this whole category (Discount Engine).
  promotions Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuPage {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String?
  /// Optional unified starting price for the page (when variants aren't itemised).
  basePrice   Float?
  type        CategoryType @default(SHOP)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  /// URL-safe identifier used for product detail routing (/product/[slug]).
  slug        String   @unique
  description String?
  images      String[]
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  // Classification
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Presentation (which menu page it appears on)
  menuPageId String
  menuPage   MenuPage @relation(fields: [menuPageId], references: [id], onDelete: Restrict)

  variants ProductVariant[]
  reviews  Review[]

  /// Promotions targeting this specific product (Discount Engine).
  promotions Promotion[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wishlistItems WishlistItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([menuPageId])
}

model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// e.g. "Scoop", "1 Litre", "6 Pieces"
  name           String
  sku            String? @unique
  price          Float
  /// Optional strikethrough / original price for promotions.
  compareAtPrice Float?
  isAvailable    Boolean @default(true)
  sortOrder      Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  /// Promotions targeting this specific variant (Discount Engine).
  promotions Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews (admin-moderated)
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id         String  @id @default(cuid())
  rating     Int // 1–5, enforced in the server action
  comment    String
  /// Snapshot of the reviewer's display name at submission time.
  authorName String
  /// Moderation flag — reviews are hidden until an admin sets this true.
  isApproved Boolean @default(false)

  // Reviews are written only by authenticated users.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One review per user per product — re-submission is a P2002, handled in
  // the server action as "you've already reviewed this product".
  @@unique([userId, productId])
  @@index([productId])
  @@index([isApproved])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cart & Orders & WishlistItem
// CartItem / OrderItem link strictly to a ProductVariant id (price integrity).
// ─────────────────────────────────────────────────────────────────────────────
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // يمنع تكرار نفس المنتج في المفضلة لنفس المستخدم
  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
}

model Order {
  id          String @id @default(cuid())
  /// Human-friendly sequential number for staff / customers.
  orderNumber Int    @unique @default(autoincrement())

  // Optional: orders may be placed by guests.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items OrderItem[]

  subtotal    Float
  deliveryFee Float @default(0)
  totalAmount Float

  status      OrderStatus       @default(PENDING)
  fulfillment FulfillmentMethod @default(DELIVERY)

  // DELIVERY → deliveryCity (+ addressLine).  PICKUP → pickupBranch.
  deliveryCity DeliveryLocation?
  addressLine  String?
  pickupBranch String?

  // Fulfilling branch — the unit of Branch-Manager RBAC. Nullable because
  // legacy orders predate branch assignment; unassigned orders are visible to
  // ADMIN only (a MANAGER's queries are filtered to their own branchId).
  // Stamped at checkout in placeOrder().
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String
  orderNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([branchId])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  // Restrict: a variant referenced by a placed order cannot be hard-deleted.
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Snapshot captured at purchase time (price resolved server-side from the variant).
  productName String
  variantName String
  unitPrice   Float
  quantity    Int

  @@index([orderId])
  @@index([variantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Café Menu (dine-in / pickup digital menu)
//
// Self-contained from the e-commerce catalogue above: the café menu is a flat
// list of categories, each holding simply-priced items, managed entirely from
// /admin/menu and rendered on the public /menu route.
//
//   MenuCategory.isFixedPrice → "Smoothies" style: every item shares one price,
//   so the storefront renders a flavour grid + a single unified price badge
//   (the shared price is read from the items, which are kept equal).
// ─────────────────────────────────────────────────────────────────────────────

model MenuCategory {
  id           String  @id @default(cuid())
  title        String
  slug         String  @unique
  /// Display order in both the storefront nav and the admin list (ascending).
  order        Int     @default(0)
  /// When true, all items share one price (flavour-grid presentation).
  isFixedPrice Boolean @default(false)

  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([order])
}

model MenuItem {
  id    String @id @default(cuid())
  /// Item name — typically Arabic (rendered RTL on the storefront).
  name  String
  price Float
  /// Display order within its category (ascending).
  order Int    @default(0)

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([order])
}

// ─────────────────────────────────────────────────────────────────────────────
// Discount Engine — Promotions
//
// A Promotion applies a discount (PERCENTAGE or FIXED_AMOUNT) over the time
// window [startDate, endDate]. It can target any mix of whole Categories,
// individual Products, and specific ProductVariants through implicit
// many-to-many join tables (Prisma manages _CategoryToPromotion,
// _ProductToPromotion and _ProductVariantToPromotion automatically).
//
// Discount math, overlap/precedence rules, and "is this promotion live right
// now" checks are enforced in app logic — the schema only stores the targets.
// ─────────────────────────────────────────────────────────────────────────────

model Promotion {
  id        String       @id @default(cuid())
  name      String
  type      DiscountType
  value     Float
  startDate DateTime
  endDate   DateTime
  isActive  Boolean      @default(true)

  // Targets — a promotion may link to any combination of the three.
  categories Category[]
  products   Product[]
  variants   ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Storefront navigation (admin-managed)
//
// A fully editorial set of footer links: each row is just a label + an href, so
// the admin can point one at a Category, a specific Product, an internal page,
// or an external/social URL — the storefront simply renders `label → url`. This
// replaces the previously hardcoded footer links (see src/components/layout/
// Footer.tsx), which fall back in only when no managed links exist.
// ─────────────────────────────────────────────────────────────────────────────

model FooterLink {
  id    String @id @default(cuid())
  /// Display text, e.g. "Our Story" or "Instagram".
  label String
  /// The href — an internal path ("/category/oriental-sweets") or absolute URL.
  url   String
  /// Column heading this link renders under in the footer, e.g. "Customer
  /// Service" or "About Us". Links sharing a group form one nav column.
  group String @default("Explore")
  /// Ascending sort position within the footer (lower = earlier). Drives both
  /// the order within a column and the left-to-right order of the columns
  /// (a column's position follows its earliest-ordered link).
  order Int    @default(0)
  /// Hidden from the storefront when false, without deleting the row.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Matches the storefront read: where isActive, ordered by `order` ascending.
  @@index([isActive, order])
}
