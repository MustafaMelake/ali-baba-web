// ─────────────────────────────────────────────────────────────────────────────
// Dual-business platform — Online Patisserie Shop + Dine-in Café Menu
// Datasource: PostgreSQL (Neon).  Connection URL is supplied by prisma.config.ts.
// Client:    `prisma-client` generator emitting to src/generated/prisma,
//            consumed via `@/generated/prisma/client` with the @prisma/adapter-pg
//            driver adapter (see src/lib/prisma.ts).
// Auth:      Better Auth standard models (User, Session, Account, Verification).
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  MANAGER // Branch Manager — scoped to a single Branch via User.branchId.
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Cities we deliver to.
enum DeliveryLocation {
  MENOUF
  SADAT
  SARS
  TITA
  BARHEEM
  AL_HAMOUL
}

/// How a Promotion's `value` is applied to a price.
enum DiscountType {
  PERCENTAGE // `value` is a percent off (e.g. 15 → 15% off)
  FIXED_AMOUNT // `value` is an absolute amount off (store currency)
}

/// What a marketing-calendar entry marks (drives its colour on /admin/calendar).
enum MarketingEventType {
  RELIGIOUS_HOLIDAY // Ramadan, the Eids, Mawlid, Coptic Christmas/Easter
  EGYPTIAN_HOLIDAY // national days off (Oct 6, Jul 23, Sham El-Nessim, …)
  RETAIL_SEASON // shopping peaks (Mother's Day, White Friday, …)
  CAMPAIGN // the shop's own planned promotion
}

// ─────────────────────────────────────────────────────────────────────────────
// Better Auth — standard models
// Field names & types must match what Better Auth's prismaAdapter expects.
// NOTE: credential passwords are stored on Account.password (NOT on User).
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)

  // Branch assignment.
  // OPTIONAL at the schema level by necessity: USER/ADMIN have no branch.
  // The rule "a MANAGER must have a branchId" is conditional and CANNOT be
  // expressed in Prisma — enforce it in app logic (and/or the DB CHECK
  // constraint described in the migration note).
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Auth relations
  sessions Session[]
  accounts Account[]

  // Business relations
  orders    Order[]
  reviews   Review[]
  cartItems CartItem[]

  wishlist  WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─────────────────────────────────────────────────────────────────────────────
// Branches (physical locations / boutiques)
// A Branch can have one or more staff users assigned to it; a "Branch Manager"
// is a User whose role == MANAGER and whose branchId points at this row.
// NOTE: Order.pickupBranch is still a free-text string — migrating it to a
// Branch relation is intentionally out of scope here.
// ─────────────────────────────────────────────────────────────────────────────

model Branch {
  id       String  @id @default(cuid())
  name     String  @unique
  /// URL-safe identifier (mirrors Category.slug), e.g. "menouf".
  slug     String  @unique
  address  String?
  phone    String?
  /// Soft on/off switch for the location without deleting it.
  isActive Boolean @default(true)

  /// Flat delivery fee (EGP) charged when this branch fulfils a DELIVERY order.
  /// Orders with no branch ("Other Areas") use StoreSettings.defaultDeliveryFee.
  deliveryFee Decimal @default(35) @db.Decimal(12, 2)

  /// Users assigned to this branch (typically role == MANAGER).
  managers User[]

  /// Orders fulfilled by this branch (see Order.branchId).
  orders Order[]

  /// This branch's stock overrides (see BranchVariantAvailability).
  variantAvailability BranchVariantAvailability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Product organization
//
//   Category  → the product's *classification*        (Modern, Croissant, …)
//   Product   → relates to a Category
//   Variant   → the purchasable unit + its price       (Scoop, Litre, Pieces)
//
// Prices live ONLY on ProductVariant; carts & orders reference a variant id so
// the price is always resolved server-side (no client-supplied prices).
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  // ── CategorySlider presentation fields ─────────────────────────────────────
  /// Short marketing tagline shown under the title in the slider card.
  subtitle String?
  /// Hero image URL (or /public path) for the slider card.
  image    String?

  /// When true, this category is surfaced in the homepage CategorySlider.
  /// Any number of categories may be featured (no longer capped at five).
  isFeatured  Boolean @default(false)
  /// Ascending display position within the slider (lower = earlier).
  sliderOrder Int     @default(0)

  products Product[]

  /// Promotions targeting this whole category (Discount Engine).
  promotions Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Matches the storefront slider read: where isFeatured, ordered by sliderOrder.
  @@index([isFeatured, sliderOrder])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  /// URL-safe identifier used for product detail routing (/product/[slug]).
  slug        String   @unique
  description String?
  images      String[]
  isAvailable Boolean  @default(true)
  isFeatured  Boolean  @default(false)

  // Classification
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variants ProductVariant[]
  reviews  Review[]

  /// Promotions targeting this specific product (Discount Engine).
  promotions Promotion[]

  /// Homepage hero slides advertising this product (SetNull on delete).
  heroSlides HeroSlide[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wishlistItems WishlistItem[]

  @@index([slug])
  @@index([categoryId])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// e.g. "Scoop", "1 Litre", "6 Pieces"
  name           String
  sku            String?  @unique
  /// Money as Decimal (not Float) so currency never drifts on binary rounding.
  price          Decimal  @db.Decimal(12, 2)
  /// Optional strikethrough / original price for promotions.
  compareAtPrice Decimal? @db.Decimal(12, 2)
  isAvailable    Boolean  @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]

  /// Per-branch stock overrides — no row for a branch means "in stock there".
  branchAvailability BranchVariantAvailability[]

  /// Promotions targeting this specific variant (Discount Engine).
  promotions Promotion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Branch stock (manager-controlled)
//
// A branch-local "out of stock" switch layered UNDER the global flags. The
// ADMIN's Product.isAvailable / ProductVariant.isAvailable stay the master
// kill-switch; this row can only take a variant away at ONE branch, never put
// back one the admin switched off. A variant is orderable at branch X iff
//
//   product.isAvailable && variant.isAvailable && row(X)?.isAvailable !== false
//
// A missing row means available, so a new branch or a new variant needs no
// seeding. Holds no price and is never read by the Discount Engine.
// ─────────────────────────────────────────────────────────────────────────────

model BranchVariantAvailability {
  id          String         @id @default(cuid())
  branchId    String
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variantId   String
  // Cascade: only a never-ordered variant can be hard-deleted (OrderItem's
  // Restrict guards the rest), and its overrides mean nothing without it.
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  isAvailable Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One switch per branch per variant — the upsert key for the toggle; its
  // branchId-leading index also serves the inventory page's per-branch read.
  @@unique([branchId, variantId])
  @@index([variantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews (admin-moderated)
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id         String  @id @default(cuid())
  rating     Int // 1–5, enforced in the server action
  comment    String
  /// Snapshot of the reviewer's display name at submission time.
  authorName String
  /// Moderation flag — reviews are hidden until an admin sets this true.
  isApproved Boolean @default(false)

  // Reviews are written only by authenticated users.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One review per user per product — re-submission is a P2002, handled in
  // the server action as "you've already reviewed this product".
  @@unique([userId, productId])
  @@index([productId])
  @@index([isApproved])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cart & Orders & WishlistItem
// CartItem / OrderItem link strictly to a ProductVariant id (price integrity).
// ─────────────────────────────────────────────────────────────────────────────
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // يمنع تكرار نفس المنتج في المفضلة لنفس المستخدم
  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, variantId])
  @@index([userId])
  @@index([variantId])
}

model Order {
  id          String @id @default(cuid())
  /// Human-friendly sequential number for staff / customers.
  orderNumber Int    @unique @default(autoincrement())

  // Optional: orders may be placed by guests.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items OrderItem[]

  // Money columns are Decimal so historical receipts never carry float drift.
  subtotal    Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  /// The VAT rate this order was billed at (0 when VAT was off), snapshotted
  /// for the receipt's label only — the VAT AMOUNT stays the residual
  /// totalAmount − subtotal − deliveryFee. A Float like StoreSettings.vatRate:
  /// a rate, not money. Null on orders placed before it was recorded.
  vatRate     Float?

  status      OrderStatus       @default(PENDING)
  fulfillment FulfillmentMethod @default(DELIVERY)

  // DELIVERY → deliveryCity (+ addressLine).  PICKUP → pickupBranch.
  deliveryCity DeliveryLocation?
  addressLine  String?
  pickupBranch String?

  // Fulfilling branch — the unit of Branch-Manager RBAC. Nullable because
  // legacy orders predate branch assignment; unassigned orders are visible to
  // ADMIN only (a MANAGER's queries are filtered to their own branchId).
  // Stamped at checkout in placeOrder().
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  customerName  String
  /// Canonical E.164 Egyptian mobile ("+201001234567") — normalized by
  /// checkoutSchema (normalizeEgyptMobile). Legacy rows the normalization
  /// migration couldn't parse keep their original text.
  customerPhone String
  orderNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([branchId])
  // Backs placeOrder's per-phone PENDING throttle (one indexed COUNT).
  @@index([customerPhone, status])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  // Restrict: a variant referenced by a placed order cannot be hard-deleted.
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Snapshot captured at purchase time (price resolved server-side from the variant).
  productName String
  variantName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int

  @@index([orderId])
  @@index([variantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Café Menu (dine-in / pickup digital menu)
//
// Self-contained from the e-commerce catalogue above: the café menu is a flat
// list of categories, each holding simply-priced items, managed entirely from
// /admin/menu and rendered on the public /menu route.
//
//   MenuCategory.isFixedPrice → "Smoothies" style: every item shares one price,
//   so the storefront renders a flavour grid + a single unified price badge
//   (the shared price is read from the items, which are kept equal).
// ─────────────────────────────────────────────────────────────────────────────

model MenuCategory {
  id           String  @id @default(cuid())
  title        String
  slug         String  @unique
  /// Display order in both the storefront nav and the admin list (ascending).
  order        Int     @default(0)
  /// When true, all items share one price (flavour-grid presentation).
  isFixedPrice Boolean @default(false)

  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([order])
}

model MenuItem {
  id    String  @id @default(cuid())
  /// Item name — typically Arabic (rendered RTL on the storefront).
  name  String
  price Decimal @db.Decimal(12, 2)
  /// Display order within its category (ascending).
  order Int     @default(0)

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([order])
}

// ─────────────────────────────────────────────────────────────────────────────
// Discount Engine — Promotions
//
// A Promotion applies a discount (PERCENTAGE or FIXED_AMOUNT) over the time
// window [startDate, endDate]. It can target any mix of whole Categories,
// individual Products, and specific ProductVariants through implicit
// many-to-many join tables (Prisma manages _CategoryToPromotion,
// _ProductToPromotion and _ProductVariantToPromotion automatically).
//
// Discount math, overlap/precedence rules, and "is this promotion live right
// now" checks are enforced in app logic — the schema only stores the targets.
// ─────────────────────────────────────────────────────────────────────────────

model Promotion {
  id        String       @id @default(cuid())
  name      String
  type      DiscountType
  /// PERCENTAGE → percent off; FIXED_AMOUNT → currency off. Decimal for money-safety.
  value     Decimal      @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime
  isActive  Boolean      @default(true)

  // Targets — a promotion may link to any combination of the three.
  categories Category[]
  products   Product[]
  variants   ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Storefront navigation (admin-managed)
//
// A fully editorial set of footer links: each row is just a label + an href, so
// the admin can point one at a Category, a specific Product, an internal page,
// or an external/social URL — the storefront simply renders `label → url`. This
// replaces the previously hardcoded footer links (see src/components/layout/
// Footer.tsx), which fall back in only when no managed links exist.
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// Store settings (admin-managed, single row)
//
// Global pricing knobs read by the checkout preview AND by `placeOrder` (the
// authoritative pricing path). The table holds exactly ONE row with the fixed
// id "store". Readers NEVER create it — a missing row is answered from the
// in-memory defaults in src/lib/store-settings.ts (which mirror the column
// defaults below); the row is created by the admin's first save in
// src/lib/actions/store-settings.ts.
// ─────────────────────────────────────────────────────────────────────────────

model StoreSettings {
  /// Fixed singleton id — always "store". Never create a second row.
  id String @id @default("store")

  /// VAT as a FRACTION (0.14 = 14%). The admin UI edits it as a percentage.
  /// Deliberately kept Float — it is a rate/fraction, not a currency amount.
  vatRate      Float   @default(0.14)
  /// Master VAT switch — when false, no VAT is shown or charged anywhere.
  isVatEnabled Boolean @default(true)

  /// Delivery fee (EGP) for DELIVERY orders not routed to a branch
  /// ("Other Areas" at checkout, or a branch that went inactive mid-order).
  defaultDeliveryFee Decimal @default(35) @db.Decimal(12, 2)

  /// The store's WhatsApp number — canonical E.164 Egyptian mobile
  /// ("+201001234567", normalizeEgyptMobile). Powers the /forgot-password
  /// hand-off; null = not configured (the page shows a neutral message).
  whatsappNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Storefront FAQ (admin-managed)
//
// Replaces the previously hardcoded FAQ list in the homepage FeaturesBar (now
// FaqAccordion). Each row is a question/answer pair with a manual sort weight and
// a soft on/off switch — the storefront reads only the active rows (ordered by
// `order`), while the admin console reads every row. The public FaqsSection
// Server Component renders these into both the accordion UI and the FAQPage
// JSON-LD used for SEO. Content lives on the homepage ("/"), so mutations bust
// that route's ISR cache.
// ─────────────────────────────────────────────────────────────────────────────

model Faq {
  id       String  @id @default(cuid())
  /// The customer-facing question, e.g. "Do you offer custom cake designs?".
  question String
  /// The answer body rendered inside the accordion panel.
  answer   String
  /// Ascending display position on the storefront (lower = earlier).
  order    Int     @default(0)
  /// Hidden from the storefront when false, without deleting the row.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Matches the storefront read: where isActive, ordered by `order` ascending.
  @@index([isActive, order])
}

// ─────────────────────────────────────────────────────────────────────────────
// Storefront locations showcase (admin-managed)
//
// Powers the "Our Locations" homepage section (BranchSelector) — an editorial,
// display-only card per physical storefront. This is DELIBERATELY separate from
// the commerce `Branch` model above: `Branch` is the fulfillment/RBAC/delivery-
// fee unit wired into Orders and Users, whereas `Location` carries only the
// marketing copy + SEO metadata for the homepage. There is no foreign key
// between them and no cart/order path here (mirrors the FAQ model's shape). The
// storefront reads only active rows (ordered by `order`); the admin console
// reads every row. Content lives on the homepage ("/"), so mutations bust that
// route's ISR cache.
// ─────────────────────────────────────────────────────────────────────────────

model Location {
  id          String  @id @default(cuid())
  /// Category pill label, e.g. "Patisserie" or "Café & Lounge".
  tag         String
  /// Opening-hours line, e.g. "09:00 AM - 11:00 PM".
  hours       String
  /// Headline for the card, e.g. "Menouf Boutique".
  title       String
  /// Editorial paragraph describing the location.
  description String
  /// Card image URL (an UploadThing/absolute URL or a /public path).
  imageUrl    String
  /// City/area for the LocalBusiness JSON-LD `addressLocality`, e.g. "Menouf".
  locality    String
  /// schema.org LocalBusiness `@type` for the JSON-LD, e.g. "Bakery" or
  /// "CafeOrCoffeeShop". A plain content string — unrelated to the removed
  /// Category/MenuPage discriminator columns.
  type        String
  /// Ascending display position on the storefront (lower = earlier).
  order       Int     @default(0)
  /// Hidden from the storefront when false, without deleting the row.
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Matches the storefront read: where isActive, ordered by `order` ascending.
  @@index([isActive, order])
}

model FooterLink {
  id       String  @id @default(cuid())
  /// Display text, e.g. "Our Story" or "Instagram".
  label    String
  /// The href — an internal path ("/category/oriental-sweets") or absolute URL.
  url      String
  /// Column heading this link renders under in the footer, e.g. "Customer
  /// Service" or "About Us". Links sharing a group form one nav column.
  group    String  @default("Explore")
  /// Ascending sort position within the footer (lower = earlier). Drives both
  /// the order within a column and the left-to-right order of the columns
  /// (a column's position follows its earliest-ordered link).
  order    Int     @default(0)
  /// Hidden from the storefront when false, without deleting the row.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Matches the storefront read: where isActive, ordered by `order` ascending.
  @@index([isActive, order])
}

// ─────────────────────────────────────────────────────────────────────────────
// Homepage hero slides (admin-managed)
//
// Editorial banners rendered inside the homepage Hero's image frame, used to
// push newly released products. Each slide has exactly ONE destination — a
// `productId` (CTA → /product/[slug], with a display-only starting price) OR a
// `linkUrl` (same href whitelist as FooterLink) — enforced by the shared
// `heroSlideSchema`, not the DB (this codebase has no CHECK constraints).
//
// Liveness = isActive && startsAt ≤ now ≤ endsAt (null = open-ended) && a valid
// destination (a LISTABLE_PRODUCT, or a linkUrl) — see `liveHeroSlideWhere`.
// No price is stored here: a product slide's price is resolved at render time
// through the Discount Engine, like every other price surface.
// ─────────────────────────────────────────────────────────────────────────────

model HeroSlide {
  id           String    @id @default(cuid())
  /// Copy overlaid on the image — all optional: an image-led slide may carry
  /// no text at all (the CTA and `imageAlt` still describe it).
  /// Small kicker above the title, e.g. "New arrival".
  eyebrow      String?
  title        String?
  subtitle     String?
  ctaLabel     String    @default("Order now")
  /// Product slides only: show the Discount-Engine starting price ("From EGP X"
  /// + strikethrough). Display-only — never stored, always resolved at render.
  showPrice    Boolean   @default(true)
  /// Desktop/tablet crop — an UploadThing URL or a /public path.
  imageDesktop String
  /// Optional art-directed phone crop; falls back to `imageDesktop`.
  imageMobile  String?
  /// Required alt text — the image is the product being launched, not decoration.
  imageAlt     String

  /// Product destination. SetNull (not Restrict/Cascade): deleting a product
  /// must neither be blocked by a banner (deleteProduct maps every P2003 to the
  /// "appears in existing orders" message) nor silently drop the slide and
  /// orphan its bucket images. A slide left with no destination is hidden from
  /// the storefront and flagged in /admin/hero.
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Link destination — "/…", "#…" or http(s):// only (isSafeHref).
  linkUrl      String?

  /// Ascending display position (lower = earlier).
  order        Int       @default(0)
  /// Hidden from the storefront when false, without deleting the row. Defaults
  /// OFF: a new slide is a draft until the admin publishes it.
  isActive     Boolean   @default(false)
  /// Cairo day edges (storeDateStart / storeDateEnd); null = open-ended.
  startsAt     DateTime?
  endsAt       DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Matches the storefront read: where isActive, ordered by `order` ascending.
  @@index([isActive, order])
  // FK index — Postgres doesn't create one; the SetNull on product delete scans it.
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketing calendar (admin-only planning)
//
// Custom reminders on the /admin/calendar planner — "Summer flash sale, 20%",
// "Open kahk pre-orders". Built-in Egyptian holidays and retail seasons are NOT
// stored: they're computed per year in src/lib/marketing-holidays.ts (Hijri
// dates via the Umm al-Qura calendar), so they never need re-seeding.
//
// A row is a planning note only — it never prices anything; a live discount is
// still a `Promotion`. No relations, so nothing cascades or restricts.
// ─────────────────────────────────────────────────────────────────────────────

model MarketingEvent {
  id                    String             @id @default(cuid())
  title                 String
  type                  MarketingEventType @default(CAMPAIGN)
  /// First day (inclusive) — a Cairo calendar DATE, no time-of-day.
  startDate             DateTime           @db.Date
  /// Last day (inclusive). endDate >= startDate is enforced by the shared
  /// marketingEventSchema (validators.ts), not the database.
  endDate               DateTime           @db.Date
  /// Free-form context, e.g. "Coordinate with the Menouf branch on capacity".
  notes                 String?
  /// Planned discount as a whole percent (1–100). A planning target, not
  /// money and never billed — hence an Int, not a Decimal.
  targetDiscountPercent Int?
  /// The plan in a line, e.g. "Pre-order kahk tins + free delivery over 500".
  strategy              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The calendar reads date windows: startDate <= rangeEnd AND endDate >= rangeStart.
  @@index([startDate, endDate])
}
